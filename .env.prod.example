# ============================================================
# cash-control — Production Environment Variables
# Copy to .env on the VPS: cp .env.prod.example .env
# NEVER commit .env to version control.
# ============================================================

# GitHub owner (username or org) — used in image names
GITHUB_OWNER=your-github-username

# Domains (DNS A records must point to this VPS before first deploy)
FRONTEND_DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# Database
DB_USERNAME=cashcontrol
DB_PASSWORD=your_secure_db_password_here

# JWT — minimum 64 characters for HS512
# Generate: openssl rand -hex 64
JWT_SECRET=your_512_bit_hex_secret_here_minimum_64_characters_required
JWT_EXPIRATION_MINUTES=15

# Brute force / lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Token expiry
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# SMTP (e.g. Resend, SendGrid, Brevo)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_api_key_here

# Google OAuth2 — from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=20
