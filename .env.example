# ============================================================
# cash-control-api — Required Environment Variables
# Copy to .env and fill in values for local development.
# NEVER commit .env to version control.
# ============================================================

# Database (PostgreSQL 18)
DB_URL=jdbc:postgresql://localhost:5432/auth
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Signing Key (minimum 64 characters for HS512)
# Generate with: openssl rand -hex 64
JWT_SECRET=your_512_bit_hex_secret_key_here_minimum_64_characters_required
JWT_EXPIRATION_MINUTES=15
# Sliding window: rotating the refresh token restarts the countdown.
JWT_REFRESH_EXPIRATION_DAYS=7
# Set to false only for local HTTP dev — a Secure cookie is never sent back over plain HTTP.
JWT_REFRESH_COOKIE_SECURE=true

# Brute Force Protection
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Token Expiry Windows
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# SMTP / Mail
# MAIL_USERNAME is the SMTP auth login (provider-specific, may not be an email address).
# MAIL_FROM is the sender address shown to recipients — must be a verified sender/domain
# with your provider, or sends will be rejected.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM=noreply@example.com

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application URLs
# APP_BASE_URL is this backend's own URL (used for CORS/OAuth2 plumbing).
# FRONTEND_BASE_URL is the React app's URL — email links (verify/reset) point here.
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth2/callback
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/auth/oauth2/error

# CORS — comma-separated list of allowed origins (no wildcard in production).
# Must include the Vite dev server's own origin (5173) for the refresh cookie
# to be accepted cross-origin now that allowCredentials is true.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# Data Retention (days)
RETENTION_PASSWORD_RESET_DAYS=30
RETENTION_VERIFICATION_TOKEN_DAYS=7
RETENTION_REFRESH_TOKEN_DAYS=30

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Attachment Storage
# Onde os anexos ficam gravados. Em produção precisa ser um volume montado: o default
# cai em java.io.tmpdir e some junto com o container a cada rebuild.
# APP_STORAGE_LOCAL_PATH=/var/lib/cash-control/attachments

# Attachment Settings
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_MAX_PER_TRANSACTION=5

# Leitura de comprovante de pagamento (PIX)
RECEIPT_IMPORT_MAX_SIZE_MB=10

# OCR de comprovante em imagem — usa o binário `tesseract` do sistema.
# Sem o binário instalado, deixe OCR_ENABLED=false: o comprovante em imagem entra
# como anexo sem campos lidos, em vez de falhar.
OCR_ENABLED=true
OCR_BINARY=tesseract
OCR_LANGUAGE=por
OCR_TIMEOUT_SECONDS=20
OCR_MAX_CONCURRENT=2

# Dashboard Widget Defaults
UPCOMING_BILLS_DAYS=7
UPCOMING_BILLS_MAX_RESULTS=20