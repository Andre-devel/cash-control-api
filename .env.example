# ============================================================
# java-auth-template — Required Environment Variables
# Copy to .env and fill in values for local development.
# NEVER commit .env to version control.
# ============================================================

# Database (PostgreSQL 18)
DB_URL=jdbc:postgresql://localhost:5432/auth
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Signing Key (minimum 64 characters for HS512)
# Generate with: openssl rand -hex 64
JWT_SECRET=your_512_bit_hex_secret_key_here_minimum_64_characters_required
JWT_EXPIRATION_MINUTES=15

# Brute Force Protection
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Token Expiry Windows
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# SMTP / Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_password_here

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application URLs
APP_BASE_URL=http://localhost:8080
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth2/callback
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/auth/oauth2/error

# CORS — comma-separated list of allowed origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# Data Retention (days)
RETENTION_PASSWORD_RESET_DAYS=30
RETENTION_VERIFICATION_TOKEN_DAYS=7

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Attachment Settings
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_MAX_PER_TRANSACTION=5

# Dashboard Widget Defaults
UPCOMING_BILLS_DAYS=7
UPCOMING_BILLS_MAX_RESULTS=20